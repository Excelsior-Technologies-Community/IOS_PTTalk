<plist version="1.0">
<dict>

    <key>NSLocalNetworkUsageDescription</key>
    <string>PTTalk uses the local network to discover and connect nearby devices.</string>

    <key>NSBonjourServices</key>
    <array>
        <string>_pttalk._tcp</string>
    </array>
    <key>NSBluetoothAlwaysUsageDescription</key>
    <string>PTTalk uses Bluetooth to discover nearby devices.</string>

    <key>NSMicrophoneUsageDescription</key>
